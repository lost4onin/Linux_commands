---
import '../styles/global.css';
import { getCheatsheet, type ConsoleLine } from '../lib/cheatsheet';
import { ui, langBase, otherLang, type Lang } from '../i18n';

export interface Tab {
  href: string;
  label: string;
}
export interface ScriptLine {
  /** in = typed command, out = its output */
  k: 'in' | 'out';
  t: string;
}

interface Props {
  lang: Lang;
  /** Full <title>. */
  title: string;
  description: string;
  /** Slug of the current section, to highlight it in the sidebar ('all' for the full sheet). */
  current?: string;
  /** The same page in the other language, if it exists. */
  alternate?: string;
  /** Tabs in the top strip: anchors of this page, highlighted while scrolling. */
  tabs?: Tab[];
  /** Console panel: lines that link to rows of this page… */
  consoleLines?: ConsoleLine[];
  /** …or a short shell session typed out on load. */
  consoleScript?: ScriptLine[];
  prev?: { url: string; title: string };
  next?: { url: string; title: string };
}

const {
  lang,
  title,
  description,
  current,
  alternate,
  tabs = [],
  consoleLines,
  consoleScript,
  prev,
  next,
} = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const base = langBase(lang);
const sheet = await getCheatsheet(lang);
const pad = (n: string) => (n ? n.padStart(2, '0') : '··');
const hasConsole = Boolean(consoleLines?.length || consoleScript?.length);

const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : undefined);
const canonical = abs(Astro.url.pathname);
const ogImage = abs('/og.png') ?? '/og.png';
const alternates =
  alternate && Astro.site
    ? [
        { hreflang: lang, href: abs(Astro.url.pathname)! },
        { hreflang: other, href: abs(alternate)! },
        { hreflang: 'x-default', href: abs(lang === 'en' ? Astro.url.pathname : alternate)! },
      ]
    : [];

// Strings for the browser scripts (src/scripts/*.ts).
const clientStrings = JSON.stringify({
  ...t.client,
  lang,
  indexUrl: `${base}/search-index.json`,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="preload" href="/fonts/silkscreen-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#edf6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b191b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:site_name" content={sheet.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={sheet.title} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Apply the saved theme (or the system one) and console state before the first paint.
      (function () {
        var d = document.documentElement, theme = null, consoleState = null;
        try { theme = localStorage.getItem('theme'); consoleState = localStorage.getItem('console'); } catch (e) {}
        var dark = theme ? theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        d.dataset.theme = dark ? 'dark' : 'light';
        if (consoleState === 'closed') d.dataset.console = 'closed';
        d.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>

    <div class="tabbar">
      <nav class="tabs-nav" aria-label={t.tabsLabel}>
        <ol class="tabs">
          {
            tabs.map((tab) => (
              <li>
                <a href={tab.href} data-tab>
                  {tab.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      {
        hasConsole && (
          <button
            class="console-toggle"
            type="button"
            aria-controls="console"
            aria-expanded="true"
            aria-label={t.consoleToggle}
            data-console-toggle
          >
            <span aria-hidden="true">{t.consoleTitle}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        )
      }
      <span class="tabbar-progress" aria-hidden="true"></span>
    </div>

    <div class:list={['shell', { 'has-console': hasConsole }]}>
      <div class="nav-backdrop" data-nav-close></div>
      <nav id="sidebar" class="sidebar" aria-label={t.sections}>
        <p class="sidebar-title" aria-hidden="true">~/{t.sections.toLowerCase()}</p>
        <ol class="nav-list">
          {
            sheet.sections.map((s) => (
              <li>
                <a href={s.url} aria-current={current === s.slug ? 'page' : undefined}>
                  <span class="nav-num" aria-hidden="true">{pad(s.number)}</span>
                  <span class="nav-label">{s.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="sidebar-foot">
          <a href={`${base}/all/`} aria-current={current === 'all' ? 'page' : undefined}>{t.fullSheet}</a>
        </div>
      </nav>

      <main id="main" tabindex="-1">
        <slot />
        <footer class="site-footer">
          <p>
            {t.footerGenerated} <code>{t.sourceFile}</code>{' · '}{t.footerPress} <kbd>/</kbd> {t.footerOr} <kbd>Ctrl</kbd>&nbsp;<kbd>K</kbd> {t.footerToSearch}{' · '}<a href={`${base}/all/`}>{t.footerFullSheet}</a>
          </p>
        </footer>
      </main>

      {
        hasConsole && (
          <aside id="console" class="console" aria-hidden="true">
            <div class="console-head">
              <span class="console-dots" />
              <span>{t.consoleTitle}</span>
            </div>
            {consoleLines?.length ? (
              <ol class="console-lines">
                {consoleLines.map((l, i) => (
                  <li class={`cl cl-${l.k}`} style={`--i:${Math.min(i, 40)}`}>
                    <a href={`#${l.id}`} tabindex="-1" data-console-target={l.id}>
                      {l.k === 'cmd' ? <span class="cl-prompt">$ </span> : l.k === 'comment' ? '// ' : ''}
                      {l.t}
                    </a>
                  </li>
                ))}
              </ol>
            ) : (
              <ol class="console-lines console-script">
                {consoleScript!.map((l, i) => (
                  <li class={`cl cl-${l.k}`} style={`--i:${i}`}>
                    <span class="cl-text">
                      {l.k === 'in' && <span class="cl-prompt">$ </span>}
                      {l.t}
                    </span>
                  </li>
                ))}
              </ol>
            )}
          </aside>
        )
      }
    </div>

    <nav class="dock" aria-label={t.dockLabel}>
      <button class="dock-btn nav-toggle" type="button" aria-controls="sidebar" aria-expanded="false" data-nav-toggle>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span class="sr-only">{t.menu}</span>
      </button>
      <a class="dock-brand" href={`${base}/`}>
        <span class="brand-mark" aria-hidden="true">&gt;_</span>
        <span class="dock-brand-text">{t.brand}</span>
      </a>
      {
        prev && (
          <a class="dock-btn" href={prev.url} rel="prev" title={prev.title}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M15 6l-6 6 6 6" /></svg>
            <span class="sr-only">{t.prevSection}: {prev.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="dock-btn" href={next.url} rel="next" title={next.title}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M9 6l6 6-6 6" /></svg>
            <span class="sr-only">{t.nextSection}: {next.title}</span>
          </a>
        )
      }
      <a class="dock-link" href={`${base}/all/`} aria-current={current === 'all' ? 'page' : undefined}>{t.footerFullSheet}</a>
      <span class="dock-spacer"></span>
      {
        alternate && (
          <a class="dock-lang" href={alternate} hreflang={other} lang={other}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
            <span class="lang-long">{t.switchLabel}</span>
            <span class="lang-short" aria-hidden="true">{t.switchShort}</span>
          </a>
        )
      }
      <button class="dock-btn theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
        <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <span class="sr-only">{t.darkMode}</span>
      </button>
      <button
        class="dock-search"
        type="button"
        data-search-open
        aria-haspopup="dialog"
        aria-keyshortcuts="/ Control+K Meta+K"
      >
        <span class="dock-search-key" aria-hidden="true">/</span>
        <span class="dock-search-label">{t.searchShort}</span>
      </button>
    </nav>

    <dialog id="search-dialog" class="search-dialog" aria-label={t.searchLabel}>
      <div class="search-panel">
        <div class="search-field">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
          <label for="search-input" class="sr-only">{t.searchLabel}</label>
          <input
            id="search-input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="search-results"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder={t.searchPlaceholder}
          />
          <button type="button" class="search-close" data-search-close>
            <span aria-hidden="true">Esc</span><span class="sr-only">{t.closeSearch}</span>
          </button>
        </div>
        <p class="search-group">{t.jumpToSection}</p>
        <div id="search-results" class="search-results" role="listbox" aria-label={t.resultsLabel}></div>
        <p class="search-status" aria-live="polite"></p>
        <p class="search-help" aria-hidden="true">
          <kbd>↑</kbd><kbd>↓</kbd> {t.helpMove} · <kbd>Enter</kbd> {t.helpOpen} · <kbd>Esc</kbd> {t.helpClose}
        </p>
      </div>
    </dialog>

    <div id="live-status" class="sr-only" role="status" aria-live="polite"></div>

    <script is:inline type="application/json" id="ui-strings" set:html={clientStrings} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
