---
import '../styles/global.css';
import { getCheatsheet } from '../lib/cheatsheet';
import { site } from '../site.config';

interface Props {
  /** Full <title>. */
  title: string;
  description: string;
  /** Slug of the current section, to highlight it in the sidebar. */
  current?: string;
}

const { title, description, current } = Astro.props;
const sheet = await getCheatsheet();
const pad = (n: string) => (n ? n.padStart(2, '0') : '··');

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f6f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1210" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sheet.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={sheet.title} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Apply the saved theme (or the system one) before the first paint.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="topbar-inner">
        <button
          class="icon-btn nav-toggle"
          type="button"
          aria-controls="sidebar"
          aria-expanded="false"
          data-nav-toggle
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <span class="sr-only">Sections menu</span>
        </button>

        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">&gt;_</span>
          <span class="brand-text">{site.brand}</span>
        </a>

        <div class="topbar-actions">
          <button
            class="search-trigger"
            type="button"
            data-search-open
            aria-haspopup="dialog"
            aria-keyshortcuts="/ Control+K Meta+K"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
            <span class="search-trigger-label">Search commands…</span>
            <kbd aria-hidden="true">/</kbd>
          </button>
          <button class="icon-btn theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
            <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <span class="sr-only">Dark mode</span>
          </button>
        </div>
      </div>
    </header>

    <div class="shell">
      <div class="nav-backdrop" data-nav-close></div>
      <nav id="sidebar" class="sidebar" aria-label="Sections">
        <p class="sidebar-title" aria-hidden="true">Sections</p>
        <ol class="nav-list">
          {
            sheet.sections.map((s) => (
              <li>
                <a href={s.url} aria-current={current === s.slug ? 'page' : undefined}>
                  <span class="nav-num" aria-hidden="true">{pad(s.number)}</span>
                  <span class="nav-label">{s.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="sidebar-foot">
          <a href="/all/" aria-current={current === 'all' ? 'page' : undefined}>Full sheet on one page</a>
        </div>
      </nav>

      <main id="main" tabindex="-1">
        <slot />
        <footer class="site-footer">
          <p>
            Generated from <code>cheatsheet.md</code>{' · '}Press <kbd>/</kbd> or <kbd>Ctrl</kbd>&nbsp;<kbd>K</kbd> to search{' · '}<a href="/all/">Full sheet</a>
          </p>
        </footer>
      </main>
    </div>

    <dialog id="search-dialog" class="search-dialog" aria-label="Search commands">
      <div class="search-panel">
        <div class="search-field">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
          <label for="search-input" class="sr-only">Search commands</label>
          <input
            id="search-input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="search-results"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Search: chmod, fork, grep -v, zombie…"
          />
          <button type="button" class="search-close" data-search-close>
            <span aria-hidden="true">Esc</span><span class="sr-only">Close search</span>
          </button>
        </div>
        <p class="search-group">Jump to a section</p>
        <div id="search-results" class="search-results" role="listbox" aria-label="Results"></div>
        <p class="search-status" aria-live="polite"></p>
        <p class="search-help" aria-hidden="true">
          <kbd>↑</kbd><kbd>↓</kbd> move · <kbd>Enter</kbd> open · <kbd>Esc</kbd> close
        </p>
      </div>
    </dialog>

    <div id="live-status" class="sr-only" role="status" aria-live="polite"></div>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
