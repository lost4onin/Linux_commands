---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title={`Page not found · ${site.titleSuffix}`} description="This page does not exist. Go back to the cheat sheet home page or search for a command.">
  <section class="not-found">
    <h1>Page not found</h1>
    <pre class="terminal-404" aria-label="Terminal message"><span class="prompt">$</span> cd <span data-missing-path>this-page</span>
bash: cd: No such file or directory</pre>
    <p>
      <a class="btn btn-primary" href="/">Back to all sections</a>
      <button class="btn" type="button" data-search-open aria-haspopup="dialog">Search commands</button>
    </p>
  </section>
</Base>
