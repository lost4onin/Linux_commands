---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
---

<Base
  lang="en"
  title={`Page not found · ${ui.en.titleSuffix}`}
  description="This page does not exist. Go back to the cheat sheet home page or search for a command."
>
  <section class="not-found" id="top">
    <p class="banner-pixel not-found-code" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <pre class="terminal-404" aria-label="Terminal message"><span class="prompt">$</span> cd <span data-missing-path>this-page</span>
bash: cd: No such file or directory</pre>
    <p class="not-found-actions">
      <a class="btn-cta" href="/">
        <span class="btn-cta-icon" aria-hidden="true">~</span>
        <span class="btn-cta-label">Back to all sections</span>
      </a>
      <button class="btn" type="button" data-search-open aria-haspopup="dialog">Search commands</button>
      <a class="btn btn-ghost" href="/fr/" hreflang="fr" lang="fr">Version française</a>
    </p>
  </section>
</Base>
