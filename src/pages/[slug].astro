---
import SectionPage from '../components/SectionPage.astro';
import { getCheatsheet } from '../lib/cheatsheet';

export async function getStaticPaths() {
  const { sections } = await getCheatsheet('en');
  return sections.map((s) => ({ params: { slug: s.slug } }));
}

// Content is looked up here (not passed as props) so `npm run dev`
// always shows the latest cheatsheet.md.
const sheet = await getCheatsheet('en');
const index = sheet.sections.findIndex((s) => s.slug === Astro.params.slug);
if (index === -1) return new Response('Section not found', { status: 404 });
---

<SectionPage lang="en" sheet={sheet} index={index} />
