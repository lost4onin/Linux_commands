---
import Base from '../layouts/Base.astro';
import { getCheatsheet } from '../lib/cheatsheet';

const sheet = await getCheatsheet();
const pad = (n: string) => (n ? n.padStart(2, '0') : '··');
---

<Base title={`${sheet.title}`} description={sheet.description}>
  <section class="hero" aria-labelledby="page-title">
    <p class="prompt-line" aria-hidden="true"><span class="prompt">$</span> cat cheatsheet.md<span class="caret"></span></p>
    <h1 id="page-title">{sheet.title}</h1>
    <div class="intro" set:html={sheet.introHtml} />
    <div class="hero-actions">
      <button class="btn btn-primary" type="button" data-search-open aria-haspopup="dialog">
        Search all commands <kbd aria-hidden="true">/</kbd>
      </button>
      <a class="btn" href="/all/?print=1" data-print-link>Print / Save as PDF</a>
      <a class="btn btn-ghost" href="/all/">Full sheet on one page</a>
    </div>
  </section>

  <section class="sections" aria-labelledby="sections-title">
    <div class="sections-head">
      <h2 id="sections-title">Sections</h2>
      <div class="chips" role="group" aria-label="Filter sections by topic" data-chips hidden>
        <button type="button" class="chip" aria-pressed="true" data-topic="all">All</button>
        {
          sheet.topics.map((t) => (
            <button type="button" class="chip" aria-pressed="false" data-topic={t.id}>
              {t.label}
              <span class="chip-count" aria-hidden="true">{t.count}</span>
            </button>
          ))
        }
      </div>
    </div>
    <p class="filter-status" data-filter-status hidden>
      <span data-filter-count></span>
      <a href="/all/" data-revise-link>Revise these on one page</a>
    </p>

    <ul class="cards" role="list">
      {
        sheet.sections.map((s) => (
          <li class="card" data-topic={s.topic}>
            <a href={s.url}>
              <span class="card-num" aria-hidden="true">{pad(s.number)}</span>
              <h3 class="card-title">
                {s.number && <span class="sr-only">{s.number}. </span>}
                {s.title}
              </h3>
              <p class:list={['card-desc', { 'is-commands': s.summaryIsCommands }]}>{s.summary}</p>
              <span class="card-meta">{s.entryCount} entries</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
