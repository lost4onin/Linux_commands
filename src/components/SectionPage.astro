---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { getCheatsheet, hasLang, type Section, type Cheatsheet } from '../lib/cheatsheet';
import { ui, langBase, otherLang, type Lang } from '../i18n';
import { downloads } from '../site.config';

interface Props {
  lang: Lang;
  sheet: Cheatsheet;
  index: number;
}

const { lang, sheet, index } = Astro.props;
const t = ui[lang];
const base = langBase(lang);
const section: Section = sheet.sections[index]!;
const prev = sheet.sections[index - 1];
const next = sheet.sections[index + 1];
const pad = (n: string) => (n ? n.padStart(2, '0') : '··');

// Same section in the other language (or that language's home page).
const other = otherLang(lang);
let alternate: string | undefined;
if (hasLang(other)) {
  const otherSheet = await getCheatsheet(other);
  alternate = otherSheet.sections.find((s) => s.slug === section.slug)?.url ?? `${langBase(other)}/`;
}

const shortSummary =
  section.summary.length > 110
    ? section.summary.slice(0, 107).replace(/\s+\S*$/, '') + '…'
    : section.summary;
const description = `${section.heading}. ${shortSummary} — ${sheet.title}.`;

// Optional download (e.g. the original exam PDF), with its size read at build time.
const dl = downloads[section.slug];
let download: { href: string; name: string; label: string; size: string } | undefined;
if (dl) {
  const onDisk = path.join(process.cwd(), 'public', dl.file);
  if (fs.existsSync(onDisk)) {
    const kb = Math.round(fs.statSync(onDisk).size / 1024);
    download = { href: dl.file, name: path.basename(dl.file), label: dl.label[lang], size: `PDF · ${kb} KB` };
  }
}
---

<Base
  lang={lang}
  title={`${section.heading} · ${t.titleSuffix}`}
  description={description}
  current={section.slug}
  alternate={alternate}
  consoleLines={section.console}
  prev={prev && { url: prev.url, title: prev.heading }}
  next={next && { url: next.url, title: next.heading }}
>
  <article class="section-page">
    <header class="section-banner frame" id="top">
      <p class="banner-pixel" aria-hidden="true">
        <span class="banner-num">{pad(section.number)}</span>
        {section.shortTitle}
      </p>
      <h1>
        {section.number && <span class="h-num">{section.number}.</span>}
        {' '}{section.title}
      </h1>
      <p class="page-meta">
        {t.entries(section.entryCount)} · <a href={`${base}/all/#${section.slug}`}>{t.seeInFullSheet}</a>
      </p>
      {
        download && (
          <p class="banner-actions">
            <a class="btn-cta" href={download.href} download={download.name} type="application/pdf">
              <span class="btn-cta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
              </span>
              <span class="btn-cta-label">
                {download.label}
                <span class="btn-cta-meta">{download.size}</span>
              </span>
            </a>
          </p>
        )
      }
    </header>

    <div class="prose" set:html={section.html} />

    <nav class="prevnext" aria-label={t.prevNext}>
      {
        prev ? (
          <a class="prevnext-link prev" href={prev.url} rel="prev" data-reveal>
            <span class="prevnext-dir">{t.previous}</span>
            <span class="prevnext-title">{prev.heading}</span>
          </a>
        ) : (
          <a class="prevnext-link prev" href={`${base}/`} data-reveal>
            <span class="prevnext-dir">{t.home}</span>
            <span class="prevnext-title">{t.allSections}</span>
          </a>
        )
      }
      {
        next ? (
          <a class="prevnext-link next" href={next.url} rel="next" data-reveal>
            <span class="prevnext-dir">{t.next}</span>
            <span class="prevnext-title">{next.heading}</span>
          </a>
        ) : (
          <a class="prevnext-link next" href={`${base}/all/`} data-reveal>
            <span class="prevnext-dir">{t.done}</span>
            <span class="prevnext-title">{t.fullSheet}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
