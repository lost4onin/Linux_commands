---
import Base from '../layouts/Base.astro';
import { getCheatsheet, hasLang } from '../lib/cheatsheet';
import { ui, langBase, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const base = langBase(lang);
const other = otherLang(lang);
const sheet = await getCheatsheet(lang);
const alternate = hasLang(other) ? `${langBase(other)}/all/` : undefined;
---

<Base
  lang={lang}
  title={`${t.fullSheetTitle} · ${t.titleSuffix}`}
  description={t.fullSheetDescription(sheet.title)}
  current="all"
  alternate={alternate}
  consoleLines={sheet.sections.map((s) => ({ k: 'cmd' as const, t: `cd ${s.slug}`, id: s.slug }))}
>
  <article class="all-page">
    <header class="page-head" id="top">
      <h1 class="hero-title">{sheet.title}</h1>
      <div class="intro" set:html={sheet.introHtml} />
      <div class="all-actions">
        <button class="btn-cta" type="button" data-print>
          <span class="btn-cta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z" /></svg>
          </span>
          <span class="btn-cta-label">{t.print}</span>
        </button>
        <p class="filter-note" data-only-note hidden>
          <span data-only-count></span>
          <a href={`${base}/all/`}>{t.showAll}</a>
        </p>
      </div>
    </header>

    {
      sheet.sections.map((s) => (
        <section class="sheet-section" id={s.slug} data-slug={s.slug} aria-labelledby={`${s.slug}-title`}>
          <h2 id={`${s.slug}-title`}>
            <a href={s.url}>
              {s.number && <span class="h-num">{s.number}.</span>} {s.title}
            </a>
          </h2>
          <div class="prose" set:html={s.htmlAll} />
        </section>
      ))
    }
  </article>
</Base>
